FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM busybox:stable

RUN adduser -D -u 1001 plugin
COPY --from=build /app/dist /plugins/headlamp-ocm
USER 1001

CMD ["sh", "-c", "cp -r /plugins/headlamp-ocm /headlamp-plugins/"]
